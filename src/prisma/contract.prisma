// use prisma-8
model User {
    id           String    @id
    name         String
    email        String    @unique
    passwordHash String
    folders      Folder[]
    sessions     Session[]
}

model Session {
    id        String   @id
    userId    String
    expiresAt DateTime
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Folder {
    id          String   @id
    userId      String
    name        String
    budgetCents Int
    createdAt   DateTime @default(now())
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    entries     Entry[]

    @@index([userId])
}

model Entry {
    id          String   @id
    folderId    String
    description String
    amountCents Int
    date        Date
    createdAt   DateTime @default(now())
    folder      Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

    @@index([folderId])
}
