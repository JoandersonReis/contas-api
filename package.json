{
  "name": "contas-api",
  "private": true,
  "scripts": {
    "dev": "tsc-watch --onSuccess 'node dist/main.js'",
    "build": "prisma contract emit && tsc",
    "start": "node dist/main.js",
    "db:emit": "prisma contract emit",
    "db:init": "prisma contract emit && prisma db init",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "temporal-polyfill": "^1.0.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "8.0.0-rc.33",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3",
    "prettier": "3.10.0"
  },
  "engines": {
    "node": ">=24.11"
  }
}
